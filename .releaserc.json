{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", { "prepareCmd": "scripts/package-app.sh ${nextRelease.version}" }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "dist/RetroX-*.zip", "label": "RetroX para macOS Apple Silicon" },
        { "path": "dist/SHA256SUMS.txt", "label": "SHA-256" }
      ],
      "successComment": false,
      "failComment": false
    }]
  ]
}
